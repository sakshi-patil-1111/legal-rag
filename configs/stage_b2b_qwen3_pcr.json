{
  "experiment_name": "stage_b2b_qwen3_pcr",
  "dataset": {
    "name": "il_pcsr",
    "data_root": "data/raw/il_pcsr",
    "split": "dev",
    "tasks": ["precedent"]
  },
  "seed": 42,
  "chunking": {"strategy": "recursive", "size": 512, "overlap": 50},
  "retrieval": {
    "type": "dense",
    "model_name": "Qwen/Qwen3-Embedding-0.6B",
    "backend": "sentence_transformers",
    "device": "cuda",
    "dtype": "float16",
    "query_prompt": "query",
    "max_length": 2048,
    "batch_size": 4,
    "cache_dir": "data/cache",
    "top_k": 10
  },
  "query": {"strategy": "direct"},
  "reranker": {"enabled": false},
  "evaluation": {"ks": [1, 2, 3, 5, 10]},
  "output_dir": "results/stage_b2b"
}
