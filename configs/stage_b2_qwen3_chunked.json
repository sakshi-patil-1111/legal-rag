{
  "experiment_name": "stage_b2_qwen3_chunked",
  "dataset": {
    "name": "il_pcsr",
    "data_root": "data/raw/il_pcsr",
    "split": "dev",
    "tasks": ["statute", "precedent"]
  },
  "seed": 42,
  "chunking": {"strategy": "recursive", "size": 512, "overlap": 50},
  "retrieval": {
    "type": "dense",
    "model_name": "Qwen/Qwen3-Embedding-0.6B",
    "backend": "sentence_transformers",
    "device": "auto",
    "query_prompt": "query",
    "batch_size": 8,
    "cache_dir": "data/cache",
    "top_k": 10
  },
  "query": {"strategy": "direct"},
  "max_queries": 10,
  "reranker": {"enabled": false},
  "evaluation": {"ks": [1, 2, 3, 5, 10]},
  "output_dir": "results/stage_b2"
}
