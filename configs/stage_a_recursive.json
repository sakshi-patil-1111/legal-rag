{
  "experiment_name": "stage_a_bm25_recursive",
  "dataset": {
    "name": "il_pcsr",
    "data_root": "data/raw/il_pcsr",
    "split": "dev",
    "tasks": ["statute", "precedent"]
  },
  "seed": 42,
  "chunking": {
    "strategy": "recursive",
    "size": 512,
    "overlap": 50
  },
  "retrieval": {
    "type": "bm25",
    "top_k": 10
  },
  "query": {
    "strategy": "direct"
  },
  "reranker": {
    "enabled": false
  },
  "evaluation": {
    "ks": [1, 3, 5, 10]
  },
  "output_dir": "results/stage_a"
}
