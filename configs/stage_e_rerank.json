{
  "experiment_name": "stage_e_rerank",
  "dataset": {
    "name": "il_pcsr",
    "data_root": "data/raw/il_pcsr",
    "split": "dev",
    "tasks": ["statute", "precedent"]
  },
  "seed": 42,
  "chunking": {"strategy": "recursive", "size": 512, "overlap": 50},
  "retrieval": {"type": "bm25", "top_k": 20},
  "query": {"strategy": "direct"},
  "reranker": {"enabled": true, "type": "cross_encoder", "model_name": "cross-encoder/ms-marco-MiniLM-L-6-v2"},
  "evaluation": {"ks": [1, 2, 3, 5, 10]},
  "output_dir": "results/stage_e"
}
